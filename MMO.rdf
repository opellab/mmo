<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:rdfa="http://www.w3.org/ns/rdfa#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#" 
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:foaf="http://xmlns.com/foaf/0.1/"
    xmlns:voaf="http://purl.org/vocommons/voaf#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:metam="http://purl.org/metam#">

    <!-- This is a preliminary version of the ontology, currently in development.-->
    
    <!-- The Meta Mesh Ontology (MMO) integrates diverse psychiatric knowledge bases into a cohesive framework, enhancing diagnostic precision and personalized treatment. -->
    <!-- It unifies medical, psychological, and social data for a comprehensive understanding of mental health. -->
    <owl:Ontology rdf:about="http://purl.org/htp">
        <rdfs:label>Meta Mesh Ontology</rdfs:label>
        <rdfs:comment>The Meta Mesh Ontology (MMO) is a unified framework designed to integrate diverse knowledge bases in psychiatry, facilitating more accurate and personalized diagnostic and treatment approaches.</rdfs:comment>
        <owl:versionInfo>1.4</owl:versionInfo>
        <dc:creator>
            <foaf:Person>
                <foaf:name>Dr. Rogério Blitz</foaf:name>
                <foaf:mbox rdf:resource="mailto:rogerio.blitz@med.uni-jena.de"/>
            </foaf:Person>
        </dc:creator>
        <dc:date>2025-04-25</dc:date>
        <dc:publisher>Dr. Rogério Blitz, Prof. Dr. Nils Opel</dc:publisher>
        <dc:contributor>Dr. Rogério Blitz,, Prof. Dr. Nils Opel</dc:contributor>
        <dcterms:issued>2024-08-21</dcterms:issued>
        <dcterms:rightsHolder>Dr. Rogério Blitz, Prof. Dr. Nils Opel</dcterms:rightsHolder>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-nc-nd/4.0/"/>
        <dcterms:rights>This work is licensed under a Creative Commons Attribution-NonCommercial-NoDerivs 4.0 International License.</dcterms:rights>
    </owl:Ontology>

    <!-- The most general category for all entities in the ontology. -->
    <!-- Serves as the top-level integration point aligning with BFO's root class. -->
    <Class rdf:about="http://purl.org/metam#Entity">
        <rdfs:label>Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000001</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
    </Class>

    <!-- Represents entities that persist through time while maintaining identity. -->
    <!-- Provides a base for all enduring concepts used in knowledge integration. -->
    <Class rdf:about="http://purl.org/metam#ContinuantEntity">
        <rdfs:label>Continuant Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000002</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
    </Class>

    <!-- Requires a bearer but is not tied to a specific individual. -->
    <!-- Useful for modeling symbolic, digital, or descriptive content. -->
    <Class rdf:about="http://purl.org/metam#GenericallyDependentEntity">
        <rdfs:label>GenericallyDependent Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000031</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
    </Class>

    <!-- Captures entities that exist independently of others. -->
    <!-- Useful for modeling physical or spatially self-sufficient units. -->
    <Class rdf:about="http://purl.org/metam#IndependentEntity">
        <rdfs:label>Independent Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000004</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
    </Class>

    <!-- Captures space-like or non-material structures. -->
    <!-- Essential for spatial modeling, especially in anatomical domains. -->
    <Class rdf:about="http://purl.org/metam#ImmaterialEntity">
        <rdfs:label>Immaterial Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000141</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
    </Class>

    <!-- Represents non-material boundaries defined by convention, not structure. -->
    <!-- Useful for modeling conceptual partitions of continuant entities. -->
    <Class rdf:about="http://purl.org/metam#ContinuantFiatBoundaryEntity">
        <rdfs:label>ContinuantFiatBoundary Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000140</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
    </Class>

    <!-- A linear conceptual boundary without surface or volume. -->
    <!-- Enables modeling of anatomical or technical axes and dividers. -->
    <Class rdf:about="http://purl.org/metam#OneDContinuantFiatBoundary">
        <rdfs:label>OneDContinuantFiatBoundary Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000142</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000142"/>
    </Class>

    <!-- A surface-like fiat boundary spanning two dimensions. -->
    <!-- Commonly used for modeling sectional planes or walls. -->
    <Class rdf:about="http://purl.org/metam#TwoDContinuantFiatBoundary">
        <rdfs:label>TwoDContinuantFiatBoundary Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000146</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
    </Class>

    <!-- A point-like fiat boundary with no dimensional extension. -->
    <!-- Ideal for abstract markers or reference points within structures. -->
    <Class rdf:about="http://purl.org/metam#ZeroDContinuantFiatBoundary">
        <rdfs:label>ZeroDContinuantFiatBoundary Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000147</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000147"/>
    </Class>

    <!-- A location or environment relative to material entities. -->
    <!-- Frequently used to integrate surgical or treatment locations. -->
    <Class rdf:about="http://purl.org/metam#SiteEntity">
        <rdfs:label>Site Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_000029</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
    </Class>

    <!-- A defined spatial extent in which entities can be located. -->
    <!-- Supports geospatial, anatomical, and modeling-related constructs. -->
    <Class rdf:about="http://purl.org/metam#SpatialRegionEntity">
        <rdfs:label>SpatialRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000006</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
    </Class>

    <!-- Represents linear spatial extents, such as paths or edges. -->
    <!-- Useful for modeling trajectories, anatomical tracts, or connections. -->   
    <Class rdf:about="http://purl.org/metam#OneDSpatialRegion">
        <rdfs:label>OneDSpatialRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000026</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000026"/>
    </Class>

    <!-- Captures volumetric spatial extents with depth, width, and height. -->
    <!-- Ideal for representing enclosed spaces like organs, rooms, or containers. -->
    <Class rdf:about="http://purl.org/metam#ThreeDSpatialRegion">
        <rdfs:label>ThreeDSpatialRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000028</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000028"/>
    </Class>

    <!-- Refers to flat spatial areas with measurable surface properties. -->
    <!-- Enables modeling of planes, membranes, or schematic representations. -->
    <Class rdf:about="http://purl.org/metam#TwoDSpatialRegion">
        <rdfs:label>TwoDSpatialRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000009</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000009"/>
    </Class>

    <!-- Denotes point-like spatial entities without extension. -->
    <!-- Suitable for modeling coordinates, intersections, or reference markers. -->
    <Class rdf:about="http://purl.org/metam#ZeroDSpatialRegion">
        <rdfs:label>ZeroDSpatialRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000018</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000018"/>
    </Class>

    <!-- Represents physical, tangible entities with mass. -->
    <!-- Forms the foundation for concrete biomedical and technical concepts. -->
    <Class rdf:about="http://purl.org/metam#MaterialEntity">
        <rdfs:label>Material Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000040</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
    </Class>

    <!-- Non-physical part of a material entity, defined by convention. -->
    <!-- Supports partonomic integration of conceptual subdivisions. -->
    <Class rdf:about="http://purl.org/metam#FiatObjectPartEntity">
        <rdfs:label>FiatObjectPart Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000024</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
    </Class>

    <!-- A bounded material entity with clear identity and unity. -->
    <!-- Commonly used for integrating anatomical or device-related terms. -->
    <Class rdf:about="http://purl.org/metam#ObjectEntity">
        <rdfs:label>Object Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000030</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
    </Class>

    <!-- An aggregate composed of multiple discrete material objects. -->
    <!-- Useful for representing systems, collections, or compound structures. -->
    <Class rdf:about="http://purl.org/metam#ObjectAggregateEntity">
        <rdfs:label>ObjectAggregate Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000027</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
    </Class>

    <!-- Depends on and inheres in another individual entity. -->
    <!-- Central for modeling roles, attributes, or conditions in context. -->
    <Class rdf:about="http://purl.org/metam#SpecificallyDependentEntity">
        <rdfs:label>SpecificallyDependent Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000020</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
    </Class>

    <!-- An inbuilt property like color, mass, or shape. -->
    <!-- Used to align observable characteristics across ontologies. -->
    <Class rdf:about="http://purl.org/metam#QualityEntity">
        <rdfs:label>Quality Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000019</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    </Class>

    <!-- Qualities involving relations between multiple entities. -->
    <!-- Captures dependencies like distance, connectivity, or similarity. -->
    <Class rdf:about="http://purl.org/metam#RelationalQualityEntity">
        <rdfs:label>RelationalQuality Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000145</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
    </Class>

    <!-- Entities that exist as potentials or capabilities. -->
    <!-- Includes roles, dispositions, and functions that may be realized. -->
    <Class rdf:about="http://purl.org/metam#RealizableEntity">
        <rdfs:label>Realizable Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000017</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
    </Class>

    <!-- A tendency or potential behavior of an entity. -->
    <!-- Used for modeling clinical risk, fragility, or reactivity. -->
    <Class rdf:about="http://purl.org/metam#DispositionEntity">
        <rdfs:label>Disposition Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000016</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
    </Class>

    <!-- An intended capability or action potential of an entity. -->
    <!-- Often associated with biological or designed purposes. -->
    <Class rdf:about="http://purl.org/metam#FunctionEntity">
        <rdfs:label>Function Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000034</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
    </Class>

    <!-- A contextual, non-essential aspect an entity can assume. -->
    <!-- Enables the modeling of temporary or situational states. -->
    <Class rdf:about="http://purl.org/metam#RoleEntity">
        <rdfs:label>Role Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000023</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    </Class>

    <!-- An entity that unfolds through time, like events or processes. -->
    <!-- Base for dynamic phenomena relevant in clinical and temporal modeling. -->
    <Class rdf:about="http://purl.org/metam#OccurrentEntity">
        <rdfs:label>Occurrent Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000003</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
    </Class>

    <!-- A temporal unfolding or change involving participants. -->
    <!-- Used for modeling diagnoses, treatments, and physiological activities. -->
    <Class rdf:about="http://purl.org/metam#ProcessEntity">
        <rdfs:label>Process Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000015</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    </Class>

    <!-- A connected sequence of past events or processes. -->
    <!-- Enables timeline-based structuring of patient or system evolution. -->
    <Class rdf:about="http://purl.org/metam#HistoryEntity">
        <rdfs:label>History Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000182</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000182"/>
    </Class>

    <!-- A generalized view over types or patterns of processes. -->
    <!-- Supports abstraction and comparison of dynamic behaviors. -->
    <Class rdf:about="http://purl.org/metam#ProcessProfileEntity">
        <rdfs:label>ProcessProfile Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000144</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000144"/>
    </Class>

    <!-- Represents a temporal limit or endpoint of a process. -->
    <!-- Useful for modeling events with precise beginnings or endings in time. -->
    <Class rdf:about="http://purl.org/metam#ProcessBoundary">
        <rdfs:label>ProcessBoundary Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000035</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
    </Class>

    <!-- A region defined in both space and time dimensions. -->
    <!-- Integrates temporal and spatial context of entities or actions. -->
    <Class rdf:about="http://purl.org/metam#SpatiotemporalRegionEntity">
        <rdfs:label>SpatiotemporalRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000011</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000011"/>
    </Class>

    <!-- A bounded interval or point in time. -->
    <!-- Provides anchors for modeling temporally dependent knowledge. -->
    <Class rdf:about="http://purl.org/metam#TemporalRegionEntity">
        <rdfs:label>TemporalRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000008</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
    </Class>

    <!-- A linear span of time with duration. -->
    <!-- Captures periods like treatments, disease progression or studies. -->
    <Class rdf:about="http://purl.org/metam#OneDTemporalRegionEntity">
        <rdfs:label>OneDTemporalRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000038</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000038"/>
    </Class>

    <!-- A point-like moment in time with no duration. -->
    <!-- Useful for events like diagnoses, time stamps, or measurements. -->
    <Class rdf:about="http://purl.org/metam#ZeroDTemporalRegionEntity">
        <rdfs:label>ZeroDTemporalRegion Entity</rdfs:label>
        <rdfs:comment>MMO-level class mapped to BFO:BFO_0000148</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000148"/>
    </Class>

    <!-- Represents an ontology module within the meta-ontology framework. -->
    <!-- Includes properties for versioning, licensing, and compliance with BFO. -->
    <owl:Class rdf:about="metam:OntologyModule">
        <rdfs:label>Ontology Module</rdfs:label>
        <rdfs:comment>A modular part of an ontology to facilitate integration.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>

    <!-- A rule that defines how concepts from different ontologies are mapped to facilitate integration. -->
    <!-- This class can be used to specify how elements from one ontology correspond to elements in another ontology. -->
    <owl:ObjectProperty rdf:about="metam:isMappedTo">
        <rdfs:label>Mapping Rule</rdfs:label>
        <rdfs:comment>Mapping from a concept in one ontology to a corresponding concept in another ontology.</rdfs:comment>
        <rdfs:domain rdf:resource="owl:Class"/>
        <rdfs:range rdf:resource="owl:Class"/>
    </owl:ObjectProperty>

    <!-- Indicates that one concept is a temporal refinement or specialization of another concept. -->
    <!-- This relationship pertains to time-bound events or processes. -->
    <owl:ObjectProperty rdf:about="metam:isTemporalRefinementOf">
        <rdfs:label>Temporal Refinement Of</rdfs:label>
        <rdfs:comment>Indicates that one concept is a temporal refinement or specialization of another concept, where the refinement is related to time-bound events or processes.</rdfs:comment>
        <rdfs:domain rdf:resource="bfo:Occurent"/>
        <rdfs:range rdf:resource="bfo:Occurent"/>
    </owl:ObjectProperty>

    <!-- Indicates that one concept is a temporal generalization or broader category of another concept. -->
    <!-- This relationship pertains to time-bound events or processes. -->
    <owl:ObjectProperty rdf:about="metam:isTemporalGeneralizationOf">
        <rdfs:label>Temporal Generalization Of</rdfs:label>
        <rdfs:comment>Indicates that one concept is a temporal generalization or broader category of another concept, where the generalization is related to time-bound events or processes.</rdfs:comment>
        <rdfs:domain rdf:resource="bfo:Occurent"/>
        <rdfs:range rdf:resource="bfo:Occurent"/>
    </owl:ObjectProperty>

    <!-- Indicates that one concept is a constant refinement or specialization of another concept. -->
    <!-- Both concepts are considered constant over time. -->
    <owl:ObjectProperty rdf:about="metam:isConstantRefinementOf">
        <rdfs:label>Constant Refinement Of</rdfs:label>
        <rdfs:comment>Indicates that one concept is a constant refinement or specialization of another concept, where both concepts are considered constant over time.</rdfs:comment>
        <rdfs:domain rdf:resource="bfo:Continuant"/>
        <rdfs:range rdf:resource="bfo:Continuant"/>
    </owl:ObjectProperty>

    <!-- Indicates that one concept is a constant generalization or broader category of another concept. -->
    <!-- Both concepts are considered constant over time. -->
    <owl:ObjectProperty rdf:about="metam:isConstantGeneralizationOf">
        <rdfs:label>Constant Generalization Of</rdfs:label>
        <rdfs:comment>Indicates that one concept is a constant generalization or broader category of another concept, where both concepts are considered constant over time.</rdfs:comment>
        <rdfs:domain rdf:resource="bfo:Continuant"/>
        <rdfs:range rdf:resource="bfo:Continuant"/>
    </owl:ObjectProperty>

    <!-- The domain or field that the ontology module is relevant to (e.g., medicine, biology). -->
    <!-- Specifies the primary area of application for the ontology module. -->
    <owl:DatatypeProperty rdf:about="metam:hasDomain">
        <rdfs:label>Domain</rdfs:label>
        <rdfs:comment>The domain or field that the ontology module is relevant to (e.g., medicine, biology).</rdfs:comment>
        <rdfs:domain rdf:resource="metam:OntologyModule"/>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <!-- Indicates whether the ontology module is compliant with the Basic Formal Ontology (BFO). -->
    <!-- This helps in verifying if the module adheres to BFO standards for ontology integration. -->
    <owl:DatatypeProperty rdf:about="metam:isBFOCompliant">
        <rdfs:label>BFO Compliant</rdfs:label>
        <rdfs:comment>This property indicates whether the ontology module is compliant with the Basic Formal Ontology (BFO).</rdfs:comment>
        <rdfs:domain rdf:resource="metam:OntologyModule"/>
        <rdfs:range rdf:resource="xsd:boolean"/>
    </owl:DatatypeProperty>

    <!-- The scope of the ontology module. -->
    <!-- Indicates whether the coverage is broad or specific. -->
    <owl:DatatypeProperty rdf:about="metam:hasScope">
        <rdfs:label>Scope</rdfs:label>
        <rdfs:comment>The scope of the ontology module (e.g., broad or specific coverage).</rdfs:comment>
        <rdfs:domain rdf:resource="metam:OntologyModule"/>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <!-- Specifies potential use cases for the ontology module. -->
    <!-- Describes the practical applications or scenarios where the ontology can be utilized. -->
    <owl:DatatypeProperty rdf:about="metam:useCase">
        <rdfs:label>Use Case</rdfs:label>
        <rdfs:comment>Specifies potential use cases for the ontology module.</rdfs:comment>
        <rdfs:domain rdf:resource="metam:OntologyModule"/>
        <rdfs:range rdf:resource="xsd:string"/>
    </owl:DatatypeProperty>

    <!-- Indicates which systems or ontologies use this module. -->
    <!-- Specifies the relationships between the ontology module and other modules or systems that rely on it. -->
    <owl:ObjectProperty rdf:about="metam:isUsedBy">
        <rdfs:label>Used By</rdfs:label>
        <rdfs:comment>Indicates which systems or ontologies use this module.</rdfs:comment>
        <rdfs:domain rdf:resource="metam:OntologyModule"/>
        <rdfs:range rdf:resource="metam:OntologyModule"/>
    </owl:ObjectProperty>

    <!-- Links a concept or class to the module in which it is defined or maintained. -->
    <!-- Supports modular architecture by specifying which OntologyModule governs the concept. -->
    <owl:ObjectProperty rdf:about="metam:isPartOfModule">
        <rdfs:label>Part of module</rdfs:label>
        <rdfs:comment>
            Specifies that a class is a constituent of a specific ontology module. 
            This property links individual ontology elements to their associated OntologyModule, 
            supporting modularization and traceability within the meta-ontology framework.
        </rdfs:comment>
        <rdfs:domain rdf:resource="owl:Class"/>
        <rdfs:range rdf:resource="metam:OntologyModule"/>
    </owl:ObjectProperty>

    <!-- Declares the original source from which a class or concept was derived. -->
    <!-- Enables provenance tracking across integrated ontologies and external knowledge systems. -->
    <owl:AnnotationProperty rdf:about="metam:hasSource">
        <rdfs:label>Source</rdfs:label>
        <rdfs:comment>
            Indicates the original source or provenance of a mapped concept, such as the originating ontology, thesaurus, or controlled vocabulary.
            Useful for documentation, transparency, and integration provenance tracking.
        </rdfs:comment>
    </owl:AnnotationProperty>

</rdf:RDF>